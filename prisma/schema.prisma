// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SUPERVISOR
  OPERARIO
}

enum Priority {
  BAJA
  MEDIA
  URGENTE
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  password         String
  name             String?
  role             Role              @default(OPERARIO)
  pushToken        String?
  phone            String?
  activeWorkGroupId String?
  activeWorkGroup  WorkGroup?        @relation("UserActiveWorkGroup", fields: [activeWorkGroupId], references: [id])
  preference       UserPreference?
  tickets          Ticket[]
  receivedTickets  Ticket[]          @relation("ReceivedTickets")
  documents        Document[]
  history          TicketHistory[]
  comments         Comment[]
  sentTramites     Tramite[]         @relation("SentTramites")
  receivedTramites Tramite[]         @relation("ReceivedTramites")
  tramiteHistory   TramiteHistory[]
  workGroupMemberships WorkGroupMember[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model UserPreference {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultInboxView     String   @default("active")
  searchMode           String   @default("semantic")
  preferredCategoryIds String?
  notifyEmail          Boolean  @default(true)
  notifyPush           Boolean  @default(true)
  notifyWhatsApp       Boolean  @default(true)
  accentColor          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Ticket {
  id              String          @id @default(uuid())
  title           String
  description     String?
  latitude        Float?
  longitude       Float?
  status          WorkflowState   @relation(fields: [workflowStateId], references: [id])
  workflowStateId String
  category        Category        @relation(fields: [categoryId], references: [id])
  categoryId      String
  subcategory     Subcategory?    @relation(fields: [subcategoryId], references: [id])
  subcategoryId   String?
  user            User            @relation(fields: [userId], references: [id])
  userId          String
  documents       Document[]
  history         TicketHistory[]
  comments        Comment[]
  priority        Priority        @default(BAJA)
  isArchived      Boolean         @default(false)
  destinatario    User?           @relation("ReceivedTickets", fields: [destinatarioId], references: [id])
  destinatarioId  String?
  messageType     String?
  tramiteSubtype  String?
  responseUrgency String?
  fechaLimite     DateTime?
  locationLabel   String?
  parentTicket    Ticket?         @relation("TicketThread", fields: [parentTicketId], references: [id])
  parentTicketId  String?
  childTickets    Ticket[]        @relation("TicketThread")
  rootTicketId    String?
  isContinuation  Boolean         @default(false)
  workGroup       WorkGroup?      @relation(fields: [workGroupId], references: [id])
  workGroupId     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Document {
  id            String   @id @default(uuid())
  name          String
  url           String
  type          String?
  version       Int      @default(1)
  isLatest      Boolean  @default(true)
  extractedText String?
  user          User     @relation(fields: [userId], references: [id])
  userId        String
  ticket        Ticket?  @relation(fields: [ticketId], references: [id])
  ticketId      String?
  tramite       Tramite? @relation(fields: [tramiteId], references: [id])
  tramiteId     String?
  folder        DocumentFolder? @relation(fields: [folderId], references: [id])
  folderId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum TramiteType {
  SOLICITUD
  CARTA
  OFICIO
  INFORME
}

model Tramite {
  id             String          @id @default(uuid())
  tipo           TramiteType
  remitente      User            @relation("SentTramites", fields: [remitenteId], references: [id])
  remitenteId    String
  destinatario   User            @relation("ReceivedTramites", fields: [destinatarioId], references: [id])
  destinatarioId String
  estado         WorkflowState   @relation(fields: [estadoId], references: [id])
  estadoId       String
  fechaLimite    DateTime?
  documents      Document[]
  comments       Comment[]
  history        TramiteHistory[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model TramiteHistory {
  id         String   @id @default(uuid())
  tramite    Tramite  @relation(fields: [tramiteId], references: [id])
  tramiteId  String
  oldStateId String?
  newStateId String
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  timestamp  DateTime @default(now())
}

model WorkflowState {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  tickets     Ticket[]
  tramites    Tramite[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Category {
  id            String         @id @default(uuid())
  name          String         @unique
  description   String?
  tickets       Ticket[]
  subcategories Subcategory[]
  workGroupTopics WorkGroupTopic[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Subcategory {
  id          String   @id @default(uuid())
  name        String
  description String?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  tickets     Ticket[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([categoryId, name])
}

model TeamSettings {
  id              String   @id @default(uuid())
  displayName     String   @default("CONECTA")
  groupIdentifier String   @default("GRUPO-001")
  logoUrl         String?
  primaryColor    String   @default("#2563eb")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model WorkGroup {
  id              String            @id @default(uuid())
  name            String
  identifier      String            @unique
  description     String?
  logoUrl         String?
  primaryColor    String            @default("#2563eb")
  isActive        Boolean           @default(true)
  members         WorkGroupMember[]
  topics          WorkGroupTopic[]
  folders         DocumentFolder[]
  tickets         Ticket[]
  activeUsers     User[]            @relation("UserActiveWorkGroup")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model WorkGroupMember {
  id          String    @id @default(uuid())
  workGroupId String
  workGroup   WorkGroup @relation(fields: [workGroupId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleInGroup String    @default("MEMBER") // LEAD | MEMBER
  createdAt   DateTime  @default(now())

  @@unique([workGroupId, userId])
}

model WorkGroupTopic {
  id          String    @id @default(uuid())
  workGroupId String
  workGroup   WorkGroup @relation(fields: [workGroupId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([workGroupId, categoryId])
}

model DocumentFolder {
  id               String    @id @default(uuid())
  name             String
  description      String?
  cloudinaryPrefix String?
  workGroupId      String
  workGroup        WorkGroup @relation(fields: [workGroupId], references: [id], onDelete: Cascade)
  documents        Document[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([workGroupId, name])
}

model TicketHistory {
  id         String   @id @default(uuid())
  ticket     Ticket   @relation(fields: [ticketId], references: [id])
  ticketId   String
  oldStateId String?
  newStateId String
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  timestamp  DateTime @default(now())
}

model AuditLog {
  id           String   @id @default(uuid())
  entityId     String
  entityType   String
  payloadHash  String
  previousHash String?
  timestamp    DateTime @default(now())
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  ticket    Ticket?  @relation(fields: [ticketId], references: [id])
  ticketId  String?
  tramite   Tramite? @relation(fields: [tramiteId], references: [id])
  tramiteId String?
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())
}
