# Server
PORT=3000
DATABASE_URL=postgresql://user:pass@localhost:5432/conecta
JWT_SECRET=change-me

# Optional AI / storage
OPENAI_API_KEY=
CLOUDINARY_URL=

# Email (SMTP) — alerts + daily digest
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
